    {
      "name": "宅门_院落陈设",
      "category": "地点",
      "tags": [
        "秋风筑物",
        "宅门"
      ],
      "words": [
        {
          "text": "垂花门：内外宅的分界，迈过去是另一个世界",
          "weight": 1
        },
        {
          "text": "正房与厢房：朝向与进深就是位分",
          "weight": 1
        },
        {
          "text": "后罩房：最里一进，住着不该露面的人",
          "weight": 1
        },
        {
          "text": "倒座房：临街朝北，下人与客人的地界",
          "weight": 1
        },
        {
          "text": "天井：一院子的光和雨，也是全院的话题场",
          "weight": 1
        },
        {
          "text": "枇杷树：院里那棵抱过的树，年年结果",
          "weight": 1
        },
        {
          "text": "水井：吃水洗衣都在那儿，夜里最安静",
          "weight": 1
        },
        {
          "text": "厨房与灶：柴米油盐的权柄所在",
          "weight": 1
        },
        {
          "text": "库房与对牌：领东西要牌，账要清",
          "weight": 1
        },
        {
          "text": "针线房：做衣绣花，也是消息集散地",
          "weight": 1
        },
        {
          "text": "佛堂：上香的地方，也是避人的地方",
          "weight": 1
        },
        {
          "text": "角门与后门：不该走的人从这儿走",
          "weight": 1
        }
      ]
    },
    {
      "name": "校园_空间与青春生态（校园空间·班级生态·青春氛围·学业秩序）",
      "category": "地点",
      "tags": [
        "秋风筑物",
        "校园"
      ],
      "words": [
        {
          "text": "【校园空间】教学楼/操场/宿舍/食堂/小卖部/图书馆——封闭校区是青春的容器，日常与心事在走廊与课桌间流转",
          "weight": 1
        },
        {
          "text": "【班级小社会】分班/座位/班委/小团体——几十人里上演微型权力与亲疏，座位即身份（前排学霸区·后排刺头区·走廊放逐席）",
          "weight": 1
        },
        {
          "text": "【青春氛围】蝉鸣盛夏/校服/课间操/运动会/毕业季——时间以学年为单位的青春呼吸；校服是规训与个性的边界画布",
          "weight": 1
        },
        {
          "text": "【学业秩序】月考/联考/排行榜/重点班——成绩是青春的第一货币与隐形分层，红榜黑榜构成压力背景",
          "weight": 1
        },
        {
          "text": "【同窗关系】同桌/室友/班主任/教导主任——关系网是世界毛细血管；老师亦师亦管，是秩序的两种面孔",
          "weight": 1
        },
        {
          "text": "【学年刻度】开学黑板报/期中目标便利贴/毕业清空的后排——空间随学年呼吸，平淡里被记住的发光时刻（联欢·秋游·成人礼）",
          "weight": 1
        }
      ]
    },
    {
      "name": "民国_沪上孤岛租界日常",
      "category": "地点",
      "tags": [
        "秋风筑物",
        "民国"
      ],
      "words": [
        {
          "text": "上海沦为孤岛：华界退进租界、洋人出面谈判",
          "weight": 1
        },
        {
          "text": "租界的居住权：洋人房东的合同 vs 华人二房东的剥削",
          "weight": 1
        },
        {
          "text": "洋人与买办：买办替洋人管华人店员、给出入门证",
          "weight": 1
        },
        {
          "text": "战时经济：物价飞涨、白米限购、外汇黑市",
          "weight": 1
        },
        {
          "text": "难民涌入：火车站的难民营、租界的避难所、教会学校",
          "weight": 1
        },
        {
          "text": "租界巡捕房：印度巡捕 vs 华捕 vs 安南巡捕",
          "weight": 1
        },
        {
          "text": "租界法庭：上海会审公廨——外国法官、华人陪审",
          "weight": 1
        },
        {
          "text": "租界巡捕的车牌：洋人 vs 买办 vs 华人三种款式",
          "weight": 1
        },
        {
          "text": "华界与租界的边界：铁栅栏、洋文岗哨、岗位上的兵",
          "weight": 1
        },
        {
          "text": "孤岛上的报纸：洋文大报 vs 中文小报，消息两套口径",
          "weight": 1
        },
        {
          "text": "孤岛上的娱乐：百乐门舞厅、长三书寓、戏院夜场",
          "weight": 1
        },
        {
          "text": "沦陷区的物价：米价、棉价、金价，一个月翻两翻",
          "weight": 1
        }
      ]
    },
    {
      "name": "求生_安全屋建造",
      "category": "地点",
      "tags": [
