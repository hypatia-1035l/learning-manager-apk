    {
      "name": "年代_票证物资",
      "category": "物品",
      "tags": [
        "秋风筑物",
        "年代"
      ],
      "words": [
        {
          "text": "粮本：一家人的口粮账，丢了等于断顿",
          "weight": 1
        },
        {
          "text": "粮票：全国与地方两本账，出省要换",
          "weight": 1
        },
        {
          "text": "布票：一年几尺，攒着做新衣",
          "weight": 1
        },
        {
          "text": "工业券：自行车缝纫机手表，攒券比攒钱难",
          "weight": 1
        },
        {
          "text": "副食本：油盐酱醋的定量，逢节多二两",
          "weight": 1
        },
        {
          "text": "介绍信：出趟门的通行证，比路费要紧",
          "weight": 1
        },
        {
          "text": "大洋与旧币：老人压箱底的钱，花与不花都是事",
          "weight": 1
        },
        {
          "text": "黑市：票证换东西的暗地，价高且担惊",
          "weight": 1
        },
        {
          "text": "定量之外：自留地、捡麦穗、河里的鱼",
          "weight": 1
        },
        {
          "text": "排队：凭票供应的队伍，队形就是秩序",
          "weight": 1
        },
        {
          "text": "攒票换大件：一家人为一台缝纫机攒三年",
          "weight": 1
        },
        {
          "text": "借票与还票：人情账比票面难算",
          "weight": 1
        }
      ]
    },
