      ]
    },
    {
      "name": "豪门_社交场域与联姻钩子",
      "category": "社会",
      "tags": [
        "秋风筑物",
        "豪门"
      ],
      "words": [
        {
          "text": "豪门宴会（鎏金灯火/同席位阶/护短暗语）：宴会是最锋利的社交战场，谁被冷落谁被护短都是权力暗语",
          "weight": 1
        },
        {
          "text": "联姻协约（分房/互不干涉/危机解除即解除）：婚前签协约先解决危机再谈感情，权力结构先于亲密",
          "weight": 1
        },
        {
          "text": "先婚后爱钩子（各取所需→细碎温柔变质）：从利益交换到“撕碎一纸契约把产业与偏爱捧至眼前”的反转",
          "weight": 1
        },
        {
          "text": "老钱审美（旗袍美人/品茗茶艺/低调做派）：以“不炫”为炫，与新贵高调炫富对峙，审美即阶层身份证",
          "weight": 1
        },
        {
          "text": "契约危机（家族企业危机/联姻救场/婚约撕毁）：外部危机把两个人绑进同一战壕，也把婚约推到重签边缘",
          "weight": 1
        },
        {
          "text": "上位者低头（重逢/追妻/强势表白）：高位者放下身段是豪门言情最带感的人设反差",
          "weight": 1
        },
        {
          "text": "名流舆论场（网红千金/热搜/家族丑闻公众化）：人设与丑闻都是资产与靶子，媒体是商战延伸",
          "weight": 1
        }
      ]
    },
    {
      "name": "豪门_资本家族与名流世界",
      "category": "社会",
      "tags": [
        "秋风筑物",
        "豪门"
      ],
      "words": [
        {
          "text": "家族企业权力结构（董事会/董事长/股权/千亿家业/继承人培养/临危受命）：企业是家族的延伸，接班是权力游戏而非温情传承",
          "weight": 1
        },
        {
          "text": "商战博弈场（地产项目/并购/做空/合约/潜规则/政商关系）：商战是世界观的冲突引擎，规则比拳脚狠，媒体舆论是延伸战场",
          "weight": 1
        },
        {
          "text": "阶层壁垒与圈层准入（京北季家/京南傅家/老钱 vs 新贵/名媛）：圈子有隐形门槛，进错场就是笑话，联姻是圈层加固手段",
          "weight": 1
        },
        {
          "text": "联姻制度（商业联姻/契约/各取所需/分房/先婚后爱）：婚姻是利益合约，感情是合约外的变量，婚约撕毁与重签是权力动作",
          "weight": 1
        },
        {
          "text": "豪门日常缝隙（网红千金人设/私人律师/司机/管家/米其林）：豪门也有普通人角色，是权力的毛细血管与读者代入视角",
          "weight": 1
        }
      ]
    },
    {
      "name": "高武_武馆与武考",
      "category": "社会",
      "tags": [
