    {
      "name": "关系_虚构关系人物",
      "category": "关系",
      "tags": [
        "秋风筑物"
      ],
      "words": [
        {
          "text": "伪单身主角：用虚构关系换自由与体面，条理型会写设定册",
          "weight": 1
        },
        {
          "text": "人设设计师：把“稳定男友”设计成可信度增强模型",
          "weight": 1
        },
        {
          "text": "虚构男友：是防御性编码不是浪漫幻想，承载真实需求",
          "weight": 1
        },
        {
          "text": "不可证伪：无社交账号、常年出差，让谎言无法被验证",
          "weight": 1
        },
        {
          "text": "错位者：顶着虚构名字的真人，身份曝光后反转",
          "weight": 1
        },
        {
          "text": "前受害者：被传“霸凌”的人，其实收过每月一万块跑腿费",
          "weight": 1
        },
        {
          "text": "暗恋观察者：从暗处看着一切，最后才被看见",
          "weight": 1
        },
        {
          "text": "闺蜜鉴定团：发起真假男友鉴定大赛的推波助澜者",
          "weight": 1
        },
        {
          "text": "热心上级：把虚构男友当“狐狸精”敌意满满",
          "weight": 1
        },
        {
          "text": "层层卸防：从维持人设到直面真心的情感重建",
          "weight": 1
        },
        {
          "text": "阶级与记忆错位：外界的认知与当事人的真相相反",
          "weight": 1
        }
      ]
    },
    {
      "name": "哨向ABO_人物羁绊母题",
      "category": "关系",
      "tags": [
        "秋风筑物",
        "哨向ABO"
      ],
      "words": [
        {
          "text": "宿命绑定：融合度/天敌设定让两人'注定'结合；强强甜宠或虐恋都由结合驱动，抗拒→臣服是经典弧光",
          "weight": 1
        },
        {
          "text": "隐藏特例：隐藏身份的超级向导、伪装普通人的哨兵、不匹配三元性别者；'我想当个普通人'的拉扯动摇设定等级",
          "weight": 1
        },
        {
          "text": "撸毛茸茸日常：精神体比本人诚实可爱，主角以吸/撸精神体调剂；用轻盈日常对冲沉重设定，是晋江哨向的标志性温情",
          "weight": 1
        },
        {
          "text": "保护与被护：哨兵 outward 保护、 inward 依赖向导；向导温和却掌握对方精神命脉；谁更脆弱随情境翻转",
          "weight": 1
        },
        {
          "text": "包办vs自由结合：家族/哨塔意志的强制匹配 vs 自由结合；标记公开度、解 bond 污名是社会压力落点",
          "weight": 1
        },
        {
          "text": "失控与救回：哨兵过载暴走→向导深入精神图景救回；'你是我唯一能靠近的人'是情感高潮母题",
          "weight": 1
        }
      ]
    },
    {
      "name": "女尊_病娇执念与囚爱日常",
      "category": "关系",
      "tags": [
        "秋风筑物",
        "女尊"
      ],
      "words": [
        {
          "text": "病娇的三段：先是装乖，再是圈禁，最后是真的疯了",
          "weight": 1
        },
        {
          "text": "囚爱的空间：公主府的偏院、地牢别院、外宅小楼",
          "weight": 1
        },
        {
          "text": "软禁的借口：养病 / 祈福 / 陪我过生辰",
          "weight": 1
        },
        {
          "text": "男主名分被吃：嫁人不能自嫁、登籍只能用主君姓",
          "weight": 1
        },
        {
          "text": "重生复仇的轻重：先报恩还是先复仇",
          "weight": 1
        },
        {
          "text": "重生前的死因：被处死 / 被赐死 / 被赐毒酒 / 自尽",
          "weight": 1
        },
        {
          "text": "被囚十年的战后心理：见到阳光就发抖、听到敲门声就躲",
          "weight": 1
        },
        {
          "text": "前世死于谁手：主君的软刀子 / 同僚的告密 / 自家亲族",
          "weight": 1
        },
        {
          "text": "重生的最大恐惧：她还在追",
          "weight": 1
        },
        {
          "text": "今生反杀：把前世最想要的东西当众毁给她看",
          "weight": 1
        },
        {
          "text": "公主青梅的可怕：小时的玩伴、少年时求亲、今夜囚了",
          "weight": 1
        },
        {
          "text": "草原公主的替身逻辑：自己像不像草原上那个人",
          "weight": 1
        }
      ]
    },
    {
      "name": "娱乐圈_协议婚约与隐婚日常",
      "category": "关系",
      "tags": [
        "秋风筑物",
        "娱乐圈"
      ],
      "words": [
        {
          "text": "婚前协议：财产/曝光义务/对外口径/解约条款的逐条拉扯",
          "weight": 1
        },
        {
          "text": "五年期限婚：结婚登记时身份证背对背，民政局看了三眼",
          "weight": 1
        },
        {
          "text": "同框的『自然感』：公共场合偶尔眼神甜一下，回家不说话",
          "weight": 1
        },
        {
          "text": "在酒店不同层的两个房间：明面剧组订婚、私下轮流回家",
          "weight": 1
        },
        {
          "text": "隐婚的『家宴』：父母知道还是装作没这桩",
          "weight": 1
        },
        {
          "text": "曝光前的踩点：被狗仔跟拍第一反应是『退婚还是公开』",
          "weight": 1
        },
        {
          "text": "怀孕的隐忍：先瘦三斤再公开、手护小腹的镜头语言",
          "weight": 1
        },
        {
          "text": "公开 vs 道歉：选择道歉的演技派=把危机转成营销",
          "weight": 1
        },
        {
          "text": "解约时的『孩子归谁』：母亲的身份挡在镜头前还是挡在家里",
          "weight": 1
        },
        {
          "text": "协议到期后的第一次公开约会：税务官问『未婚还是新欢』",
          "weight": 1
        },
        {
          "text": "隐婚对作品的拖累：商务违约、剧宣暂停",
          "weight": 1
        },
        {
          "text": "隐婚复婚：协议结束又领证，这次是给自己结",
          "weight": 1
        }
      ]
    },
    {
      "name": "娱乐圈_营业CP话术与捆绑日常",
      "category": "关系",
      "tags": [
        "秋风筑物",
