{
  "name": "learning-manager",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "prebuild": "node scripts/writeBuildInfo.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "verify": "node scripts/verify-fixes.mjs",
    "clean:android": "node -e \"require('fs').rmSync('android/app/src/main/assets/public',{recursive:true,force:true})\"",
    "sync:android": "npm run clean:android && cap sync android",
    "build:android": "npm run build && npm run sync:android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
